{
  "functions": {
    "api/ask.mjs": { "includeFiles": "api/_data/**", "maxDuration": 60, "memory": 1024 },
    "api/english.mjs": { "includeFiles": "api/_data/english/**", "maxDuration": 120, "memory": 1024 }
  },
  "redirects": [
    { "source": "/projects", "destination": "/portfolio/", "permanent": true },
    { "source": "/projects/(.*)", "destination": "/portfolio/$1", "permanent": true },
    { "source": "/tags", "destination": "/archives/", "permanent": false },
    { "source": "/tags/", "destination": "/archives/", "permanent": false }
  ]
}
